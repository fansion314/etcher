# Maintainer: Peilin Fan <peilin.fan@foxmail.com>
pkgname=etcher-dnr
pkgver=2.1.7
pkgrel=4
pkgdesc='Etcher image flasher using the shared dnr runtime'
arch=('x86_64')
url='https://github.com/balena-io/etcher'
license=('Apache-2.0')
provides=("etcher=$pkgver" "balena-etcher=$pkgver")
conflicts=('etcher-dnr-bin' 'etcher' 'etcher-bin' 'balena-etcher' 'balena-etcher-bin')
depends=('dnr>=0.4.1' 'webkit2gtk-4.1' 'gtk3' 'glib2' 'util-linux-libs' 'udisks2'
         'polkit' 'zenity' 'xdg-utils' 'libnotify' 'systemd-libs' 'systemd')
makedepends=('nodejs>=24.15' 'pnpm>=11' 'dnc>=0.4.1' 'pkgconf' 'python')
checkdepends=('xz')
options=('!strip' '!debug' 'staticlibs' 'libtool' '!purge' 'emptydirs')
_commit=bfcfafd32e3628fccf924c8d17fcdb56e4ade989
source=("etcher-${_commit}.tar.gz::https://codeload.github.com/balena-io/etcher/tar.gz/${_commit}"
        'etcher-dnr-port.tar.gz' 'etcher-dnr' 'etcher-dnr.desktop')
sha256sums=('ca4983d81dbe4cdd5f04b93b806fe177a32395bd85a9c4b12f44ef7a26167f35'
            '10316334a5ff0e29b91e5ac0e7c067ea7d9d2b43887ea9e74d94f11f7c222225'
            'c3098db5b878a1a4624e30d9434fcbb484fbbe517c03a718d7d518a9371bf83f'
            '193c10c25951ebd21fa138cadb4726b79d21bc76444e1657caf19d7f6b0485d5')

prepare() {
    cp -a "$srcdir/dnr" "$srcdir/etcher-$_commit/"
    cd "$srcdir/etcher-$_commit/dnr"
    # Use the repository Node toolchain, not an inherited Electron Node 20 pin.
    pnpm install --frozen-lockfile
}

build() {
    cd "$srcdir/etcher-$_commit/dnr"
    node build.mjs
}

check() {
    cd "$srcdir/etcher-$_commit"
    node dnr/tests/run.mjs
    cc -std=c11 -O2 -Wall -Wextra -Werror dnr/native/tests/test-native.c \
        -o "$srcdir/native-tests" $(pkg-config --cflags --libs mount gio-2.0)
    "$srcdir/native-tests"
    node dnr/tests/package.mjs
}

package() {
    cd "$srcdir/etcher-$_commit"
    # Install v4 native groups beside the archive. Root workers never need a
    # user-owned extraction directory. This command does not start the runtime.
    dnc install out/bundle/etcher.dnp "$pkgdir/usr/lib/etcher-dnr"
    install -Dm755 "$srcdir/etcher-dnr" "$pkgdir/usr/bin/etcher"
    install -Dm644 "$srcdir/etcher-dnr.desktop" "$pkgdir/usr/share/applications/etcher.desktop"
    install -Dm644 assets/icon.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/etcher.png"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 dnr/README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
